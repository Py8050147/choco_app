# Database Configuration
# PostgreSQL connection string (Supabase or local)
DATABASE_URL="postgresql://username:password@host:port/database"

# Authentication (Google OAuth)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# NextAuth Configuration
NEXTAUTH_SECRET="generate-secret-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Application URLs
NEXT_PUBLIC_BACKEND_URL="http://localhost:3000/api"
APP_BASE_URL="http://localhost:3000"

# Next.js Server Actions
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="generate-with-openssl-rand-base64-32"

# ImageKit Configuration (Get from ImageKit dashboard)
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY="public_your_public_key"
NEXT_PUBLIC_IMAGEKIT_PRIVATE_KEY="private_your_private_key"
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_endpoint"

# Payment Gateway (Optional - Razorpay integration)
# RAZORPAY_KEY_ID="your_razorpay_key_id"
# RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# Cryptomus Payment (Optional - Crypto payments)
# CRYPTOMUS_MERCHANT_ID="your_merchant_id"
# CRYPTOMUS_API_KEY="your_api_key"